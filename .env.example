# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# SUI Wallet Addresses (comma-separated)
# SUI 鏈上資料直接從公鏈 RPC 取得，無需 API key
SUI_WALLET_ADDRESSES=0xaddress1,0xaddress2

# 元大證券
# PDF 對帳單解密密碼（通常是身分證字號）
YUANTA_PDF_PASSWORD=your_id_number
# Gmail OAuth credentials 放置路徑：.secrets/gmail_credentials.json（從 GCP Console 下載）
# 授權後自動產生 token：.secrets/gmail_token.json


# ── IBKR ──────────────────────────────────────────────────────────────────────
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_query_id
