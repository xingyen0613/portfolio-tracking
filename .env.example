# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# SUI Wallet Addresses (comma-separated)
# SUI 鏈上資料直接從公鏈 RPC 取得，無需 API key
SUI_WALLET_ADDRESSES=0xaddress1,0xaddress2

# 元大證券
# PDF 對帳單解密密碼（通常是身分證字號）
YUANTA_PDF_PASSWORD=your_id_number
# Gmail OAuth credentials 放置路徑：.secrets/gmail_credentials.json（從 GCP Console 下載）
# 授權後自動產生 token：.secrets/gmail_token.json


# ── IBKR ──────────────────────────────────────────────────────────────────────
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_query_id

# ── EVM Wallets (Etherscan API v2) ────────────────────────────────────────────
# 同一把 API key 支援所有 EVM 鏈
# API key 申請：https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key
# 錢包地址（逗號分隔；同一組地址會在所有指定的鏈上查詢）
EVM_WALLET_ADDRESSES=0xaddress1,0xaddress2
# 要查詢的鏈（逗號分隔）
# 免費 Etherscan key 支援：ethereum, arbitrum, polygon, linea, stable(988)
# 需付費 key：bsc, optimism, base, avalanche
EVM_CHAINS=ethereum,arbitrum,stable

# 自訂代幣白名單（可選）格式：合約:代幣:小數位:是否穩定幣:coingecko_id
# 多個代幣以逗號分隔；穩定幣的 coingecko_id 填 -
EVM_TOKENS_ethereum=0x1f9840a85d5af5bf1d1762f925bdaddc4201f984:UNI:18:false:uniswap,0x514910771af9ca656af840dff83e8264ecf986ca:LINK:18:false:chainlink
EVM_TOKENS_arbitrum=0x0c880f6761f1af8d9aa9c466984b80dab9a8c9e8:PENDLE:18:false:pendle
EVM_TOKENS_stable=0xYourContract:TOKEN:18:false:token-id
