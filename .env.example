# ── Database ──────────────────────────────────────────────────────────────────
# 本機開發：docker compose up -d 後使用預設值即可
DATABASE_URL=postgresql://portfolio:portfolio_dev@localhost:5432/portfolio

# ── CORS ─────────────────────────────────────────────────────────────────────
# 逗號分隔，本機開發不用設（預設 localhost:5173）
# 部署後填入 Cloudflare Pages 的 https 域名
ALLOWED_ORIGINS=https://your-app.pages.dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# 隨機 32 字元以上的字串，用於簽發 JWT
JWT_SECRET=random-32-char-secret
# 你的 Google 帳號 email，首次登入時自動接管 SYSTEM_OWNER_ID 的歷史資料
OWNER_GOOGLE_EMAIL=your@gmail.com

# ── API Keys ──────────────────────────────────────────────────────────────────
# 錢包地址請放 config/.env.wallets

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# 元大證券
# PDF 對帳單解密密碼（通常是身分證字號）
YUANTA_PDF_PASSWORD=your_id_number
# Gmail OAuth credentials 放置路徑：.secrets/gmail_credentials.json（從 GCP Console 下載）
# 授權後自動產生 token：.secrets/gmail_token.json

# ── IBKR ──────────────────────────────────────────────────────────────────────
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_query_id

# ── Alchemy（EVM + Solana）────────────────────────────────────────────────────
# 單一 API key 支援所有 EVM 鏈及 Solana
# API key 申請：https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key
