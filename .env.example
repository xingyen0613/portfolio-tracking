# ── Database ──────────────────────────────────────────────────────────────────
# 本機開發：docker compose up -d 後使用預設值即可
DATABASE_URL=postgresql://portfolio:portfolio_dev@localhost:5432/portfolio

# ── CORS ─────────────────────────────────────────────────────────────────────
# 逗號分隔，本機開發不用設（預設 localhost:5173）
# 部署後填入 Cloudflare Pages 的 https 域名
ALLOWED_ORIGINS=https://your-app.pages.dev

# ── Encryption ───────────────────────────────────────────────────────────────
# 用於加密 user_connectors.credentials_json 中的 API key
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Google OAuth Client Secret（用於元大 Gmail OAuth code exchange）
# GCP Console → OAuth 2.0 Client → 下載 JSON 裡的 client_secret
GOOGLE_CLIENT_SECRET=your_client_secret
# 隨機 32 字元以上的字串，用於簽發 JWT
JWT_SECRET=random-32-char-secret
# 你的 Google 帳號 email，首次登入時自動接管 SYSTEM_OWNER_ID 的歷史資料
OWNER_GOOGLE_EMAIL=your@gmail.com
# 元大 Gmail OAuth callback URL（需與 GCP Console 的 redirect URI 一致）
# 本機開發用 http://localhost:8000/api/auth/yuanta/gmail/callback
# 部署後改為 https://<api-domain>/api/auth/yuanta/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/yuanta/gmail/callback
# 前端域名（OAuth 完成後 redirect 回前端用）
# 本機開發用 http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Cloud Scheduler 觸發 /api/internal/trigger-batch 時帶的共享密鑰
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET=your-random-scheduler-secret

# ── API Keys ──────────────────────────────────────────────────────────────────
# 錢包地址請放 config/.env.wallets

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# 元大證券
# PDF 對帳單解密密碼（通常是身分證字號）
YUANTA_PDF_PASSWORD=your_id_number
# Gmail OAuth credentials 放置路徑：.secrets/gmail_credentials.json（從 GCP Console 下載）
# 授權後自動產生 token：.secrets/gmail_token.json

# ── IBKR ──────────────────────────────────────────────────────────────────────
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_query_id

# ── 永豐證券 (Shioaji) ────────────────────────────────────────────────────────
# 永豐 e-leader → API 申請：https://www.sinotrade.com.tw/CSCenter/CSCenter_13_8
# 本機跑 batch 時若 user_connectors 沒設定，會從 env 讀取 fallback
SINOPAC_API_KEY=your_sinopac_api_key
SINOPAC_SECRET_KEY=your_sinopac_secret_key
# 設為 true 使用 shioaji simulation 模式（測試用，不需正式環境 key）；生產環境不設或設 false
SINOPAC_SIMULATION=false

# ── Alchemy（EVM + Solana）────────────────────────────────────────────────────
# 單一 API key 支援所有 EVM 鏈及 Solana
# API key 申請：https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key

# ── ECPay 綠界（訂閱金流，定期定額）──────────────────────────────────────────
# 測試環境用官方公開測試帳號（沙盒共用，非機密）；正式環境換成自己的特店帳號
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
# 測試 https://payment-stage.ecpay.com.tw / 正式 https://payment.ecpay.com.tw
ECPAY_BASE_URL=https://payment-stage.ecpay.com.tw
# 每期扣款金額（新台幣整數，= 建單 TotalAmount）
ECPAY_PERIOD_AMOUNT=50
# 綠界 server callback 需要公開可達的 HTTPS 網址（443），localhost 收不到
# 本機測試：ngrok http 8000 之後填 https://xxxx.ngrok-free.app
BACKEND_PUBLIC_URL=https://your-backend.example.com
# 付款完成導回的前端網址（本機開發不設，預設 http://localhost:5173）
FRONTEND_BASE_URL=http://localhost:5173
