# ── Wallet Addresses ──────────────────────────────────────────────────────────
# 此檔案僅放錢包地址，API key 請放 .env

# EVM Wallets（逗號分隔；同一組地址會在所有 EVM_CHAINS 上查詢）
EVM_WALLET_ADDRESSES=0xaddress1,0xaddress2

# 要查詢的 EVM 鏈（逗號分隔）
# 免費 Alchemy key 支援：ethereum, arbitrum, base, polygon, optimism, bsc, avalanche, linea, stable(988)
EVM_CHAINS=ethereum,arbitrum,base,polygon,stable

# SUI Wallet Addresses（逗號分隔）
# SUI 鏈上資料直接從公鏈 RPC 取得，無需 API key
SUI_WALLET_ADDRESSES=0xaddress1,0xaddress2

# Solana Wallet Addresses（逗號分隔）
SOL_WALLET_ADDRESSES=YourSolanaAddress1,YourSolanaAddress2
